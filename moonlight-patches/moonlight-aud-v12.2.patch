diff --git a/app/src/main/java/com/limelight/binding/input/DualSenseHidraw.java b/app/src/main/java/com/limelight/binding/input/DualSenseHidraw.java
new file mode 100644
index 00000000..6d7d24d5
--- /dev/null
+++ b/app/src/main/java/com/limelight/binding/input/DualSenseHidraw.java
@@ -0,0 +1,179 @@
+package com.limelight.binding.input;
+
+import android.view.InputDevice;
+
+import com.limelight.LimeLog;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.FileReader;
+import java.io.IOException;
+import java.util.zip.CRC32;
+
+// Writes DualSense output reports (lightbar, adaptive triggers) directly to the
+// controller's hidraw node. Used where the kernel driver doesn't expose these
+// features through Android's LightsManager (e.g. 5.4 kernels without LED multicolor).
+public class DualSenseHidraw {
+    private static final int SONY_VID = 0x054c;
+    private static final int DS5_PID = 0x0ce6;
+    private static final int DS5_EDGE_PID = 0x0df2;
+
+    // Offsets inside the common output report section
+    private static final int VALID_FLAG0 = 0;
+    private static final int VALID_FLAG1 = 1;
+    private static final int RIGHT_TRIGGER = 10;
+    private static final int LEFT_TRIGGER = 21;
+    private static final int LIGHTBAR_RGB = 44;
+    private static final int COMMON_SIZE = 47;
+
+    private static final int FLAG0_RIGHT_TRIGGER = 0x04;
+    private static final int FLAG0_LEFT_TRIGGER = 0x08;
+    private static final int FLAG1_LIGHTBAR = 0x04;
+
+    // Trigger effect type that turns resistance off
+    private static final byte TRIGGER_EFFECT_OFF = 0x05;
+
+    private final String path;
+    private final boolean bluetooth;
+    private FileOutputStream out;
+    private int seq;
+
+    private DualSenseHidraw(String path, boolean bluetooth) {
+        this.path = path;
+        this.bluetooth = bluetooth;
+    }
+
+    public static boolean isDualSense(InputDevice dev) {
+        return dev.getVendorId() == SONY_VID &&
+                (dev.getProductId() == DS5_PID || dev.getProductId() == DS5_EDGE_PID);
+    }
+
+    public static DualSenseHidraw open(InputDevice dev) {
+        if (!isDualSense(dev)) {
+            return null;
+        }
+
+        File[] nodes = new File("/sys/class/hidraw").listFiles();
+        if (nodes == null) {
+            return null;
+        }
+
+        String wantedProduct = String.format("%08X", dev.getProductId());
+        DualSenseHidraw fallback = null;
+        for (File node : nodes) {
+            String hidId = null, hidName = null;
+            try (BufferedReader reader = new BufferedReader(new FileReader(new File(node, "device/uevent")))) {
+                String line;
+                while ((line = reader.readLine()) != null) {
+                    if (line.startsWith("HID_ID=")) {
+                        hidId = line.substring(7).toUpperCase();
+                    }
+                    else if (line.startsWith("HID_NAME=")) {
+                        hidName = line.substring(9);
+                    }
+                }
+            } catch (IOException e) {
+                continue;
+            }
+
+            // HID_ID is BUS:VENDOR:PRODUCT, e.g. 0005:0000054C:00000DF2
+            if (hidId == null || !hidId.endsWith("0000054C:" + wantedProduct)) {
+                continue;
+            }
+
+            DualSenseHidraw candidate = new DualSenseHidraw("/dev/" + node.getName(), hidId.startsWith("0005:"));
+            if (dev.getName().equals(hidName)) {
+                fallback = candidate;
+                break;
+            }
+            if (fallback == null) {
+                fallback = candidate;
+            }
+        }
+
+        if (fallback != null) {
+            LimeLog.info("DualSense hidraw for " + dev.getName() + ": " + fallback.path +
+                    (fallback.bluetooth ? " (BT)" : " (USB)"));
+        }
+        return fallback;
+    }
+
+    public synchronized void setLightbar(int r, int g, int b) {
+        byte[] common = new byte[COMMON_SIZE];
+        common[VALID_FLAG1] = FLAG1_LIGHTBAR;
+        common[LIGHTBAR_RGB] = (byte) r;
+        common[LIGHTBAR_RGB + 1] = (byte) g;
+        common[LIGHTBAR_RGB + 2] = (byte) b;
+        send(common);
+    }
+
+    public synchronized void setTriggers(byte eventFlags, byte typeLeft, byte typeRight, byte[] left, byte[] right) {
+        byte[] common = new byte[COMMON_SIZE];
+        if ((eventFlags & FLAG0_RIGHT_TRIGGER) != 0) {
+            common[VALID_FLAG0] |= FLAG0_RIGHT_TRIGGER;
+            common[RIGHT_TRIGGER] = typeRight;
+            System.arraycopy(right, 0, common, RIGHT_TRIGGER + 1, Math.min(right.length, 10));
+        }
+        if ((eventFlags & FLAG0_LEFT_TRIGGER) != 0) {
+            common[VALID_FLAG0] |= FLAG0_LEFT_TRIGGER;
+            common[LEFT_TRIGGER] = typeLeft;
+            System.arraycopy(left, 0, common, LEFT_TRIGGER + 1, Math.min(left.length, 10));
+        }
+        if (common[VALID_FLAG0] != 0) {
+            send(common);
+        }
+    }
+
+    public synchronized void resetTriggers() {
+        byte[] common = new byte[COMMON_SIZE];
+        common[VALID_FLAG0] = FLAG0_RIGHT_TRIGGER | FLAG0_LEFT_TRIGGER;
+        common[RIGHT_TRIGGER] = TRIGGER_EFFECT_OFF;
+        common[LEFT_TRIGGER] = TRIGGER_EFFECT_OFF;
+        send(common);
+    }
+
+    public synchronized void close() {
+        if (out != null) {
+            try {
+                out.close();
+            } catch (IOException ignored) {}
+            out = null;
+        }
+    }
+
+    private void send(byte[] common) {
+        byte[] report;
+        if (bluetooth) {
+            report = new byte[78];
+            report[0] = 0x31;
+            report[1] = (byte) ((seq++ & 0x0f) << 4);
+            report[2] = 0x10;
+            System.arraycopy(common, 0, report, 3, COMMON_SIZE);
+
+            CRC32 crc = new CRC32();
+            crc.update(0xa2);
+            crc.update(report, 0, report.length - 4);
+            long value = crc.getValue();
+            report[74] = (byte) value;
+            report[75] = (byte) (value >> 8);
+            report[76] = (byte) (value >> 16);
+            report[77] = (byte) (value >> 24);
+        }
+        else {
+            report = new byte[48];
+            report[0] = 0x02;
+            System.arraycopy(common, 0, report, 1, COMMON_SIZE);
+        }
+
+        try {
+            if (out == null) {
+                out = new FileOutputStream(path);
+            }
+            out.write(report);
+        } catch (IOException e) {
+            LimeLog.warning("DualSense hidraw write failed on " + path + ": " + e.getMessage());
+            close();
+        }
+    }
+}
